PORT=8787
HOST=0.0.0.0
APP_NAME=DNS Guardian

# keep true until credentials and probe endpoints are ready
MOCK_MODE=true

# Cloudflare legacy Global API Key authentication
CF_API_EMAIL=
CF_API_KEY=

# Optional Cloudflare API Token fallback
CF_API_TOKEN=
CF_ZONE_ID=

# AWS CLI mode
AWS_REGION=ap-east-1
AWS_CLI_BIN=aws
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional external probes. Each endpoint should return:
# {"reachable":true,"latencyMs":80,"region":"CN-HK"}
PROBE_ENDPOINTS=

# Optional speed target, for example a small static file on each server.
SPEED_TEST_PATH=/speedtest.bin
AUTO_INTERVAL_SECONDS=60
